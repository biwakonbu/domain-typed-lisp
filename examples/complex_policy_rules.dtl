; syntax: surface
; @context: facts

(fact 有効ユーザー :terms (uA))
(fact 有効ユーザー :terms (uB))
(fact 商品販売中 :terms (p1))
(fact 商品販売中 :terms (p2))
(fact 検収済み :terms (p2))
(fact 担当種別 :terms (uA (一般)))
(fact 担当種別 :terms (uB (法人)))


; @context: policy

(rule :head (注文許可 ?u ?p) :body (and (有効ユーザー ?u) (商品販売中 ?p)))
(rule :head (注文許可 ?u ?p) :body (and (担当種別 ?u (法人)) (検収済み ?p)))

(assert 注文矛盾なし :params ((u ユーザー) (p 商品)) :formula (not (and (注文許可 u p) (not (注文許可 u p)))))


; @context: prove

(universe ユーザー :values (uA uB uC))
(universe ユーザー列 :values ((空) (連結 uA (空)) (連結 uB (連結 uA (空))) (連結 uC (空))))
(universe 会員種別 :values ((一般) (法人)))
(universe 商品 :values (p1 p2))

(defn 有効ユーザー存在
  :params ((xs ユーザー列))
  :ret Bool
  :body (match xs ((空) false) ((連結 h t) (if (有効ユーザー h) true (有効ユーザー存在 t)))))
(defn 注文可能判定
  :params ((u ユーザー) (p 商品))
  :ret (Refine b Bool (注文許可 u p))
  :body (注文許可 u p))
