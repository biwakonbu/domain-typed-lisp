; syntax: surface
; @context: default

(sort 主体)
(sort 契約)

(data 顧客種別 :constructors ((法人) (個人)))

(relation 契約登録 :args (契約))
(relation 契約締結可能 :args (主体 契約 顧客種別))
(relation 担当顧客種別 :args (主体 顧客種別))

(fact 担当顧客種別 :terms (山田 (法人)))
(fact 担当顧客種別 :terms (佐藤 (個人)))
(fact 契約登録 :terms (基本契約))
(fact 契約登録 :terms (特約))

(rule :head (契約締結可能 ?担当 ?契約ID ?種別) :body (and (担当顧客種別 ?担当 ?種別) (契約登録 ?契約ID)))

(universe 主体 :values (山田 佐藤))
(universe 契約 :values (基本契約 特約))
(universe 顧客種別 :values ((法人) (個人)))

(defn 契約可否
  :params ((担当 主体) (契約ID 契約) (種別 顧客種別))
  :ret (Refine b Bool (契約締結可能 担当 契約ID 種別))
  :body (契約締結可能 担当 契約ID 種別))
