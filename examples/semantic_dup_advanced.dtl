; syntax: surface
; @context: schema

(sort ユーザー)

(relation 同値候補 :args (ユーザー))
(relation 有効 :args (ユーザー))
(relation 監査対象 :args (ユーザー))


; @context: facts

(fact 有効 :terms (u1))
(fact 監査対象 :terms (u1))
(fact 監査対象 :terms (u2))


; @context: rules

(rule :head (同値候補 ?u) :body (and (有効 ?u) (監査対象 ?u) true))
(rule :head (同値候補 ?x) :body (and (監査対象 ?x) (有効 ?x)))


; @context: assertions

(assert candidate_a :params ((u ユーザー)) :formula (and (同値候補 u) true))
(assert candidate_b :params ((v ユーザー)) :formula (同値候補 v))


; @context: functions

(defn 同値関数_a
  :params ((u ユーザー))
  :ret Bool
  :body (同値候補 u))
(defn 同値関数_b
  :params ((x ユーザー))
  :ret Bool
  :body (if true (同値候補 x) false))

; @context: universe

(universe ユーザー :values (u1 u2))
