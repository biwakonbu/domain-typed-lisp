; syntax: surface
; @context: schema

(sort ユーザー)
(sort 商品)

(data ユーザー列 :constructors ((空) (連結 ユーザー ユーザー列)))
(data 会員種別 :constructors ((一般) (法人)))

(relation 商品販売中 :args (商品))
(relation 担当種別 :args (ユーザー 会員種別))
(relation 有効ユーザー :args (ユーザー))
(relation 検収済み :args (商品))
(relation 注文許可 :args (ユーザー 商品))
