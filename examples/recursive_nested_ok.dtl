; syntax: surface
; @context: default

(data Nat :constructors ((z) (s Nat)))

(assert nested-recursion-always-true :params () :formula true)

(universe Nat :values ((z) (s (z)) (s (s (z)))))

(defn nested-rec-ok
  :params ((n Nat))
  :ret Bool
  :body (match n ((z) true) ((s m) (let ((alias m)) (match alias ((z) true) ((s mm) (nested-rec-ok mm)))))))
